@using BulkyBook.Models
@model Product

<h1></h1>

<div class="container-fluid py-3">
    <a asp-action="Index" class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1 mb-3">
        <i class="bi bi-arrow-left"></i> Back to categories
    </a>
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4" style="background: linear-gradient(to right, #065f46, #282828, #191414);">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-lg me-2"></i>Create Category</h5>
            <p class="mb-0 small" style="color: #1DB954;">Delete an existing category</p>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold small">Product Title</label>
                    <input type="text" readonly name="Title" asp-for="Title" class="form-control" placeholder="Product title" />
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small">Description</label>
                    <input type="text" readonly name="Description" asp-for="Description" class="form-control" placeholder="Product description" />
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger fw-semibold">Delete</button>
                    <a asp-action="Index" class="btn btn-light fw-medium">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>